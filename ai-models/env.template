# CareerPilot AI models (FastAPI) — copy to .env: cp env.template .env
# Use the same JWT_SECRET as backend/.env

PORT=8000
HOST=0.0.0.0
RELOAD=false
LOG_LEVEL=info

# Must match backend/.env — CV Agent verifies JWTs issued by Node.js only
JWT_SECRET=change-me-in-production
CV_AGENT_AUTH_DISABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Hugging Face — required for Modal CV analysis deploy (model download on GPU)
#   https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
# Off by default; loading falls back to templates instead of blocking for hours.
ALLOW_MODEL_DOWNLOAD=false

# CV writer (Phi-3 base + LoRA adapter — transformers/GPU path only)
PHI3_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
PHI3_MODEL=basmalaalaa029/phi3-cv
PHI3_ADAPTER_SUBFOLDER=checkpoint-200
USE_PHI3_WRITER=true
CV_TEMPLATE_FALLBACK=true

JUDGE_BASE_MODEL=OsamaHayba/qwen-ats-merged-stage1
JUDGE_ADAPTER_PATH=OsamaHayba/cv-analysis-final-stage2
WRITER_MODEL=Qwen/Qwen2.5-7B-Instruct
HR_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct

USE_MISTRAL_WRITER=false
MISTRAL_MODEL=basmalaalaa029/cv-finetuned-mistral

# ── CV analysis (Modal) ───────────────────────────────────────────────────────
# Workspace: myhywgxtj-arch — https://modal.com/apps/myhywgxtj-arch/main
# Secrets:  https://modal.com/secrets/myhywgxtj-arch/main
# Deploy:   MODAL_PROFILE=myhywgxtj-arch ./scripts/deploy_modal_analysis.sh
# Poll auth: set MODAL_PROFILE so FunctionCall.from_id() works from the API server
MODAL_PROFILE=myhywgxtj-arch
MODAL_ENDPOINT_URL=
MODAL_POST_TIMEOUT=180
MODAL_POLL_TIMEOUT=1800
MODAL_REQUEST_TIMEOUT=1800
MODAL_MAX_NEW_TOKENS=800
ANALYSIS_SESSION_TTL_SECONDS=3600
ANALYSIS_SESSION_MAX=500

CV_WARMUP_MODEL=false
MODEL_PRELOAD_MODE=full

DEVICE=auto
LOAD_IN_4BIT=true

MAX_ITERATIONS=1
SCORE_THRESHOLD=82
NUM_CANDIDATES=1
CV_FAST_MODE=auto
WRITER_MAX_TOKENS=3000
JUDGE_MAX_TOKENS=1200

RATE_LIMIT_RPM=0
PIPELINE_WORKERS=2

SESSION_DB=cv_sessions.db
OUTPUT_DIR=output
LOG_DIR=logs

# ── Job-Matcher (Groq + live job boards) ──────────────────────────────────────
# Groq — free at https://console.groq.com (interview LLM + job-matcher parsing)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Adzuna (optional, free at developer.adzuna.com — adds ~50 jobs/query)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

GOOGLE_API_KEY=
LANGCHAIN_API_KEY=

# ── CV generation (Gemini) ────────────────────────────────────────────────────
# Required for AI CV enhancement — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=3000

# ── Career Interview (Groq LLM + embeddings + optional Whisper/Piper) ──
# Groq key is shared with job-matcher above (GROQ_API_KEY)
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Piper TTS for interview /speak (install: bash scripts/install_piper_voice.sh)
PIPER_MODEL_PATH=~/piper-voices/en_US-lessac-medium.onnx
WHISPER_BACKEND=local
WHISPER_MODEL=tiny
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=3
MIN_QUESTIONS=8
MAX_QUESTIONS=8
FOLLOWUP_SCORE_THRESHOLD=6.0
WEAK_SCORE_THRESHOLD=5.0
EARLY_STOP_SCORE=3.0
EARLY_STOP_COUNT=5
MAX_SESSION_FOLLOWUPS=5
MIN_SESSION_FOLLOWUPS=3
MAX_FOLLOWUPS_PER_QUESTION=2
