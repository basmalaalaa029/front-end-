# CareerPilot AI models (FastAPI) — copy to .env: cp env.template .env
# Use the same JWT_SECRET as backend/.env

PORT=8000
HOST=0.0.0.0
RELOAD=false
LOG_LEVEL=info

# Must match backend/.env — CV Agent verifies JWTs issued by Node.js only
JWT_SECRET=change-me-in-production
CV_AGENT_AUTH_DISABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Hugging Face — accept gated model terms before first run:
#   https://huggingface.co/basmalaalaa029/phi3-cv
HUGGINGFACE_TOKEN=
# GGUF backend fetches models explicitly, so the slow transformers auto-download
# is off by default; loading falls back to templates instead of blocking.
ALLOW_MODEL_DOWNLOAD=false

# ── Inference backend ─────────────────────────────────────────────────────────
# auto -> llama_cpp (quantized GGUF, fast on CPU) when no CUDA, else transformers.
# Run scripts/download_gguf.py (+ scripts/convert_to_gguf.py on a GPU) first.
INFERENCE_BACKEND=auto
GGUF_DIR=models/gguf
PHI3_GGUF_PATH=phi3-cv-Q4_K_M.gguf
# Fine-tuned Qwen ATS judge — downloaded from basmalaalaa029/cv-analysis-gguf
ATS_GGUF_REPO=basmalaalaa029/cv-analysis-gguf
ATS_GGUF_FILE=cv-analysis-Q4_K_M.gguf
ATS_GGUF_PATH=cv-analysis-Q4_K_M.gguf
HR_GGUF_PATH=qwen2.5-7b-instruct-Q4_K_M.gguf
WRITER_GGUF_PATH=qwen2.5-7b-instruct-Q4_K_M.gguf

# CV writer (Phi-3 base + LoRA adapter — transformers/GPU path only)
PHI3_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
PHI3_MODEL=basmalaalaa029/phi3-cv
PHI3_ADAPTER_SUBFOLDER=checkpoint-200
USE_PHI3_WRITER=true
CV_TEMPLATE_FALLBACK=true

# GPU/transformers path only — ignored when INFERENCE_BACKEND=llama_cpp or auto+no CUDA
JUDGE_BASE_MODEL=OsamaHayba/qwen-ats-merged-stage1
JUDGE_ADAPTER_PATH=OsamaHayba/cv-analysis-final-stage2
WRITER_MODEL=Qwen/Qwen2.5-7B-Instruct
HR_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct

USE_MISTRAL_WRITER=false
MISTRAL_MODEL=basmalaalaa029/cv-finetuned-mistral
ANALYSIS_USE_MISTRAL_JUDGE=false

# ── CV analysis (llama-server + GGUF) ─────────────────────────────────────────
CV_ANALYSIS_MODEL_REPO=basmalaalaa029/cv-analysis-gguf
CV_ANALYSIS_MODEL_FILE=cv-analysis-Q4_K_M.gguf
CV_ANALYSIS_MODEL_GPU_LAYERS=0
CV_ANALYSIS_LLAMA_SERVER_URL=http://127.0.0.1:8080
CV_ANALYSIS_LLAMA_SERVER_PORT=8080
CV_ANALYSIS_LLAMA_SERVER_BIN=bin/llama-server
CV_ANALYSIS_MOCK_INFERENCE=false
CV_ANALYSIS_WARMUP_ON_STARTUP=true

ANALYSIS_CPU_MODE=dual_reuse_ats
ANALYSIS_WARMUP_MODEL=true
CV_WARMUP_MODEL=false
MODEL_PRELOAD_MODE=full

DEVICE=auto
LOAD_IN_4BIT=true

MAX_ITERATIONS=1
SCORE_THRESHOLD=82
NUM_CANDIDATES=1
CV_FAST_MODE=auto
WRITER_MAX_TOKENS=3000
JUDGE_MAX_TOKENS=1200
ANALYSIS_JUDGE_MAX_TOKENS_CPU=1200
ANALYSIS_JUDGE_N_CTX=8192

RATE_LIMIT_RPM=0
PIPELINE_WORKERS=2

SESSION_DB=cv_sessions.db
OUTPUT_DIR=output
LOG_DIR=logs

GROQ_API_KEY=                  # optional — enables LLM CV parsing + explanations (free at console.groq.com)
GOOGLE_API_KEY=
LANGCHAIN_API_KEY=

# ── CV generation (Gemini) ────────────────────────────────────────────────────
GEMINI_API_KEY=                # required for AI CV enhancement
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=3000

# ── Job-Matcher live job board APIs ─────────────────────────────────────────
# Adzuna (optional, free at developer.adzuna.com — adds ~50 jobs/query)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
