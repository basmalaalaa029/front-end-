# CareerPilot AI models (FastAPI) — copy to .env: cp env.template .env
# Use the same JWT_SECRET as backend/.env

PORT=8000
HOST=0.0.0.0
RELOAD=false
LOG_LEVEL=info

# Must match backend/.env — CV Agent verifies JWTs issued by Node.js only
JWT_SECRET=change-me-in-production
CV_AGENT_AUTH_DISABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Hugging Face — accept gated model terms before first run:
#   https://huggingface.co/basmalaalaa029/phi3-cv
HUGGINGFACE_TOKEN=
# GGUF backend fetches models explicitly, so the slow transformers auto-download
# is off by default; loading falls back to templates instead of blocking.
ALLOW_MODEL_DOWNLOAD=false

# ── Inference backend ─────────────────────────────────────────────────────────
# auto -> llama_cpp (quantized GGUF, fast on CPU) when no CUDA, else transformers.
# Run scripts/convert_to_gguf.py on a GPU for phi3 writer GGUF if needed.
INFERENCE_BACKEND=auto
GGUF_DIR=models/gguf
PHI3_GGUF_PATH=phi3-cv-Q4_K_M.gguf
HR_GGUF_PATH=qwen2.5-7b-instruct-Q4_K_M.gguf
WRITER_GGUF_PATH=qwen2.5-7b-instruct-Q4_K_M.gguf

# CV writer (Phi-3 base + LoRA adapter — transformers/GPU path only)
PHI3_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
PHI3_MODEL=basmalaalaa029/phi3-cv
PHI3_ADAPTER_SUBFOLDER=checkpoint-200
USE_PHI3_WRITER=true
CV_TEMPLATE_FALLBACK=true

# GPU/transformers path only — ignored when INFERENCE_BACKEND=llama_cpp or auto+no CUDA
JUDGE_BASE_MODEL=OsamaHayba/qwen-ats-merged-stage1
JUDGE_ADAPTER_PATH=OsamaHayba/cv-analysis-final-stage2
WRITER_MODEL=Qwen/Qwen2.5-7B-Instruct
HR_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct

USE_MISTRAL_WRITER=false
MISTRAL_MODEL=basmalaalaa029/cv-finetuned-mistral

